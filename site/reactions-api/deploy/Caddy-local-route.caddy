	@glossaliae_reactions_local path /glossaliae/reactions-local
	handle @glossaliae_reactions_local {
		request_body {
			max_size 256
		}
		reverse_proxy 127.0.0.1:8792 {
			header_up X-Glossaliae-Client-IP {remote_host}
			transport http {
				dial_timeout 3s
				response_header_timeout 10s
			}
		}
	}
